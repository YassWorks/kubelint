root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,md,toml}]
indent_size = 2

# Test fixtures may contain deliberately odd formatting.
[crates/**/resources/test/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = false
